{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipeContent",
  "description": "Предлагаемый формат содержимого рецепта v1. Метаданные хранения и состояние интерфейса находятся вне этого объекта.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "servings", "time", "ingredients", "steps", "userNotes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "servings": {"type": "integer", "minimum": 1, "maximum": 100},
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalMinutes", "activeMinutes"],
      "properties": {
        "totalMinutes": {"type": "integer", "minimum": 1},
        "activeMinutes": {"type": "integer", "minimum": 1}
      }
    },
    "ingredients": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ingredient"}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "userNotes": {"type": "string", "description": "Личные заметки пользователя. Не заполняются и не перезаписываются моделью."}
  },
  "$defs": {
    "localId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "unit": {"type": "string", "enum": ["g", "kg", "ml", "l", "piece", "tsp", "tbsp", "pinch", "clove", "bunch"]},
    "quantity": {
      "anyOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value", "unit"],
          "properties": {"kind": {"const": "exact"}, "value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"$ref": "#/$defs/unit"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "min", "max", "unit"],
          "properties": {"kind": {"const": "range"}, "min": {"type": "number", "exclusiveMinimum": 0}, "max": {"type": "number", "exclusiveMinimum": 0}, "unit": {"$ref": "#/$defs/unit"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"enum": ["to_taste", "as_needed"]}}
        }
      ]
    },
    "ingredient": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "quantity", "preparation", "group", "optional"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "name": {"type": "string", "minLength": 1},
        "quantity": {"$ref": "#/$defs/quantity"},
        "preparation": {"type": ["string", "null"], "description": "Например: мелко нарезать; жирность 20%."},
        "group": {"type": ["string", "null"], "description": "Например: соус. null означает отсутствие группы."},
        "optional": {"type": "boolean"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "instruction", "ingredientIds", "timerSeconds"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "instruction": {"type": "string", "minLength": 1, "description": "Полная инструкция. Количества целых ингредиентов выводятся по ingredientIds, без дублирования чисел в тексте."},
        "ingredientIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/localId"}},
        "timerSeconds": {"type": ["integer", "null"], "minimum": 1, "description": "Необязательная длительность одного таймера, а не полная длительность шага."}
      }
    }
  }
}
