# Server only. Copy to .env, do not expose through Vite or commit real values.
APP_ENV=development
DATABASE_URL=sqlite:///./data/recipebook.db
PUBLIC_APP_URL=http://localhost:5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Empty credentials/model keep LLM unavailable; manual recipe editing still works.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=6000
LLM_MAX_CONVERSATION_TOKENS=16000

# Explicit local development login; never enable in production.
DEV_AUTH_ENABLED=false
